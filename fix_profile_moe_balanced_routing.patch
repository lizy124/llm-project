+def get_profile_balanced_topk_ids(
+    topk_ids: torch.Tensor,
+    top_k: int,
+    num_logical_experts: int,
+) -> torch.Tensor:
+    token_ids = torch.arange(topk_ids.size(0), device=topk_ids.device).unsqueeze(1)
+    expert_offsets = torch.arange(top_k, device=topk_ids.device).unsqueeze(0)
+    return ((token_ids * top_k + expert_offsets) % num_logical_experts).to(topk_ids.dtype)
+
